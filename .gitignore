# Machine-local only (never push)
local/
# PATH shim marker + bob/bob.cmd launchers (created on first command)
local/bin/
local/.path-configured
.local/

# Session / agent scratch (per-developer, per-ticket runs)
local/agent/

# WireMock runtime (PID, logs, downloaded JAR when copied here)
local/.runtime-wiremock/
local/.runtime-services/
runner/.runtime-wiremock/
runner/lib/wiremock-standalone-*.jar

# Duplicate generated trees under runner/ (canonical copy is assets/)
runner/api-catalog/
runner/assertion-catalog/
runner/stub-registry/bank-operations/
runner/stub-profiles/

# Python
__pycache__/
*.pyc
.pytest_cache/
runner/tests/_scratch_context_audit/
*.hprof

# IDE (IntelliJ / Cursor)
.idea/

# Marker file (runtime)
assets/.bob-initialized

# Host-specific catalogs (discover-apis / sync-graph on local machine)
assets/api-catalog/apis/
assets/platform-graph/platform-graph.yaml

# Ticket-local WireMock stubs (validate-ticket / discover-apis; keep committed samples)
assets/stub-registry/bank-operations/*/
!assets/stub-registry/bank-operations/getCardSummary/

# Bob hygiene reports (context-audit, memory-budget, meta-review, mcp-audit)
docs/CONTEXT_USAGE_AUDIT.md
docs/CONTEXT_ALL_CHATS_CUMULATIVE.md
docs/CONTEXT_ALL_CHATS_CUMULATIVE.json
docs/CONTEXT_CONVERSATION_BREAKDOWN.md
docs/CONTEXT_CONVERSATION_BREAKDOWN.json
docs/MEMORY_BUDGET.md
docs/MCP_AUDIT.md
docs/META_REVIEW.md
